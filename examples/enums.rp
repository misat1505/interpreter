# This is a concept file. It typechecks for now, but is not executable in any mode.

struct Deadline {
    str date
};

enum Task {
    InProgress(Deadline),
    Completed(str),
    Aborted
};

struct TaskRepository {
    Task[] tasks
};

let repo = TaskRepository {
    tasks: [
        Task::InProgress(Deadline { date: "today" }),
        Task::Completed("completed"),
        Task::Aborted
    ]
};

