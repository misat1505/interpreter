import "./lexer.rp";
import "./parser.rp";
import "./json-serializer.rp";


fn main(): void {
    let source = read_file("./projects/xml-to-json/data/data1.xml");
    let lexer = lexer_new(source);
    let parser = parser_new(&lexer);
    let ast = parser_parse(&parser);
    let serializer = json_serializer_new();
    json_serializer_serialize(&serializer, &ast);
    write_file("./projects/xml-to-json/output/out1.json", serializer.serialized);
}

main();
