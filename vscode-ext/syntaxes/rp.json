{
  "scopeName": "source.rp",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#enum-definitions"
    },
    {
      "include": "#enum-variants"
    },
    {
      "include": "#types"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#constants"
    },
    {
      "include": "#operators"
    },
    {
      "include": "#functions"
    },
    {
      "include": "#variables"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.number-sign.rp",
          "match": "#.*$"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.rp",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.rp",
              "match": "\\\\."
            }
          ]
        },
        {
          "name": "string.quoted.single.rp",
          "match": "'(\\\\.|[^'\\\\])'"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.rp",
          "match": "\\b(fn|extern|if|else|for|while|switch|return|break|continue|import|as|match|rest)\\b"
        }
      ]
    },
    "enum-definitions": {
      "patterns": [
        {
          "begin": "\\b(enum)\\s+([A-Z][a-zA-Z0-9_]*)\\s*\\{",
          "beginCaptures": {
            "1": {
              "name": "constant.language.rp"
            },
            "2": {
              "name": "entity.name.type.rp"
            }
          },
          "end": "\\}",
          "patterns": [
            {
              "include": "#comments"
            },
            {
              "include": "#strings"
            },
            {
              "include": "#enum-variant-definition"
            },
            {
              "include": "#types"
            },
            {
              "include": "#numbers"
            },
            {
              "include": "#constants"
            },
            {
              "include": "#operators"
            },
            {
              "include": "#functions"
            },
            {
              "include": "#variables"
            }
          ]
        }
      ]
    },
    "enum-variant-definition": {
      "patterns": [
        {
          "match": "^\\s*([A-Z][a-zA-Z0-9_]*)\\b",
          "captures": {
            "1": {
              "name": "variable.other.enummember.rp"
            }
          }
        }
      ]
    },
    "enum-variants": {
      "patterns": [
        {
          "match": "\\b([A-Z][a-zA-Z0-9_]*)::([a-zA-Z_][a-zA-Z0-9_]*)\\b",
          "captures": {
            "1": {
              "name": "entity.name.type.rp"
            },
            "2": {
              "name": "variable.other.enummember.rp"
            }
          }
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.rp",
          "match": "\\b(true|false|let|struct|enum)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "entity.name.type.primitive.rp",
          "match": "\\b(i8|i16|i32|i64|u8|u16|u32|u64|f64|bool|str|char|void)\\b"
        },
        {
          "name": "entity.name.type.rp",
          "match": "(?<!::)\\b[A-Z][a-zA-Z0-9_]*\\b"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.rp",
          "match": "\\b[0-9]+(?:'[0-9]+)*(\\.[0-9]+(?:'[0-9]+)*)?\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.rp",
          "match": "(==|!=|<=|>=|<|>|\\+|\\-|\\*|\\/|%|=|&&|\\|\\||!)"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "name": "entity.name.function.rp",
          "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*\\s*(?=\\()"
        },
        {
          "name": "entity.name.function.definition.rp",
          "match": "(?<=\\bfn\\s+)[a-zA-Z_][a-zA-Z0-9_]*"
        }
      ]
    },
    "variables": {
      "patterns": [
        {
          "name": "variable.other.rp",
          "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*\\b"
        }
      ]
    }
  }
}